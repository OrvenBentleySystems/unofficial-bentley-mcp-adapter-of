{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "STAAD Assistant dev prototype",
    "websiteUrl": "https://github.com/BentleySystems/openstaad-mcp",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/termofuse"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "STAAD Assistant${{APP_NAME_SUFFIX}}",
    "full": "STAAD Assistant (read-only OpenSTAAD MCP)"
  },
  "description": {
    "short": "Live read-only STAAD.Pro status via OpenSTAAD MCP",
    "full": "Declarative agent for Microsoft 365 Copilot that reads live STAAD.Pro runtime status (instances, connection, model summary) from the developer's workstation through an authenticated gateway in front of the Bentley OpenSTAAD MCP server. Read-only."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "composeExtensions": [],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "declarativeAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity"
  ],
  "validDomains": []
}
