# Copy to .env.local (git-ignored). No secrets are required by the STAAD gateway.
# Your Microsoft Entra user object ID(s) allowed to call the gateway (comma separated). REQUIRED.
STAAD_GW_ALLOWED_OIDS=
# Entra tenant GUID. Used before provisioning; afterwards AAD_APP_TENANT_ID from agent/env is used.
STAAD_GW_TENANT_ID=
# Optional overrides
# STAAD_GW_PORT=18130
# STAAD_GW_REQUIRED_SCOPES=access_as_user
# STAAD_GW_ALLOWED_CLIENT_IDS=ab3be6b7-f5df-413d-ac2d-abf1e3fd9c0b
# STAAD_GW_UPSTREAM_TIMEOUT_S=30
# STAAD_GW_MAX_BODY_BYTES=65536

# Bentley MCP bridge (optional; loopback HTTP only, stdio needs neither)
# BENTLEY_MCP_PORT=18131
# Set to require Authorization: Bearer <token> on the HTTP endpoint.
# BENTLEY_MCP_TOKEN=
